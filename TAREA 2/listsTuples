my_lista = ['Rojo', 'Azul', 'Amarillo', 'Naranja', 'Violeta', 'Verde']  # Creamos una lista
# input()  # Entrada de datos por teclado
print(my_lista)  # Mostramos la lista
print(type(my_lista))  # Mostramos el tipo de dato
print(my_lista[2])  # Accedemos al elemento de la posición 2

print("my_lista size: ", len(my_lista))  # Cantidad de elementos
print(my_lista[0:2])  # Mostramos las posiciones 0 y 1
print(my_lista[:2])  # Igual que [0:2]

my_lista.append('Blanco')  # Agrega un elemento al final
print(my_lista)  # Mostramos la lista

my_lista.insert(3, 'Negro')  # Agrega Negro en la posición 3
print(my_lista)  # Mostramos la lista

my_lista.extend(['Marron', 'Gris'])  # Agrega varios elementos
print(my_lista)  # Mostramos la lista

print(my_lista.index('Azul'))  # Muestra la posicion de Azul

# my_lista.remove('Magenta')  # Daria error porque Magenta no existe
my_lista.remove('Marron')  # Elimina Marron
print(my_lista)  # Mostramos la lista

my_lista.insert(8, 'Marron')  # Agregamos Marron en la posición 8
print(my_lista)  # Mostramos la lista

print(my_lista.pop())  # Elimina y muestra el ultimo elemento

size = len(my_lista)  # Guardamos el tamaño de la lista
print("size = ", size)  # Mostramos el tamaño

# print(my_lista.pop(size))  # No se usa porque size no es un índice válido

my_lista_3 = my_lista * 3  # Repetimos la lista 3 veces
print("my_lista_3: ", my_lista_3)  # Mostramos la nueva lista


