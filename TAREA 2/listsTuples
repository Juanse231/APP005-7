my_tupla = tuple(my_lista)  # Convertimos la lista en tupla
print()  # Línea en blanco
print()  # Línea en blanco
print("my_tuple: ", my_tupla)  # Mostramos la tupla

print(my_tupla[0])  # Primer elemento
print(my_tupla[2])  # Tercer elemento

print('Rojo' in my_tupla)  # Verificamos si Rojo existe
print(my_tupla.count('Rojo'))  # Contamos cuantas veces aparece Rojo

my_tupla_unitaria = ('Blanco')  # Esto realmente es un string
